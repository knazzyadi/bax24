  APPROVED
  REJECTED
}

enum ContractStatus {
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WorkOrderTypeEnum {
  MAINTENANCE
  CORRECTIVE
  EMERGENCY
  BULK_PREVENTIVE
}
