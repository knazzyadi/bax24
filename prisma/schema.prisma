generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. النماذج الأساسية (Companies, Users, Roles, Branches...)
// ============================================================

model Company {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  nameEn                 String?
  address                String?
  phone                  String?
  email                  String?
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  contracts              Contract[]
  inventoryItems         InventoryItem[]
  maintenanceSchedules   MaintenanceSchedule[]
  tickets                Ticket[]
  workOrders             WorkOrder[]
  workOrderPriorities    WorkOrderPriority[]
  workOrderStatuses      WorkOrderStatus[]
  workOrderTypes         WorkOrderType[]
  assetStatuses          AssetStatus[]
  assetTypes             AssetType[]
  assets                 Asset[]
  branches               Branch[]
  buildings              Building[]
  users                  User[]
  workOrderCloseReasons  WorkOrderCloseReason[]
  workOrderCancelReasons WorkOrderCancelReason[]
  suppliers Supplier[]

  @@map("companies")
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String?
  password          String?
  status            Boolean      @default(true)
  companyId         String?
  roleId            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  invitationToken   String?      @unique
  invitationExpires DateTime?
  resetToken        String?      @unique
  resetExpires      DateTime?
  firstLogin        Boolean      @default(true)
  
  // ✅ إضافة حقل الحذف الناعم (Soft Delete)
  deletedAt         DateTime?    // سيسمح بالاستعلام عن المستخدمين غير المحذوفين فقط

  // العلاقات
  userBranches      UserBranch[]
  company           Company?     @relation(fields: [companyId], references: [id])
  role              Role?        @relation(fields: [roleId], references: [id])
  
  // ✅ العلاقات مع WorkOrder (تم إزالة التكرار)
  createdWorkOrders  WorkOrder[] @relation("CreatedWorkOrders")
  assignedWorkOrders WorkOrder[] @relation("AssignedWorkOrders")
  // ❌ تم حذف: workOrders WorkOrder[] @relation("AssignedWorkOrders")

  // ✅ إضافة علاقة التذاكر (المستخدم الذي أنشأ التذكرة)
  tickets           Ticket[]     @relation("UserTickets")

  @@map("users")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("roles")
}

model UserBranch {
  userId     String
  branchId   String
  assignedAt DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Branch {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  nameEn               String?
  allowPublicTickets   Boolean               @default(true)
  publicToken          String                @unique @default(cuid())
  slug                 String                @unique
  contracts            Contract[]
  maintenanceSchedules MaintenanceSchedule[]
  tickets              Ticket[]
  workOrders           WorkOrder[]
  assets               Asset[]
  company              Company               @relation(fields: [companyId], references: [id])
  buildings            Building[]
  userBranches         UserBranch[]

  @@map("branches")
}

model Building {
  id                   String                @id @default(cuid())
  name                 String
  nameEn               String?
  code                 String                @unique
  order                Int                   @default(0)
  branchId             String?
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  maintenanceSchedules MaintenanceSchedule[]
  assets               Asset[]
  branch               Branch?               @relation(fields: [branchId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id])
  floors               Floor[]
  rooms                Room[]
  vehicles             Vehicle[]

  @@index([companyId, deletedAt])
  @@index([branchId])
  @@index([createdAt])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(cuid())
  name       String
  nameEn     String?
  code       String
  buildingId String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms      Room[]

  @@unique([buildingId, code])
  @@map("floors")
}

model Room {
  id                   String                 @id @default(cuid())
  name                 String
  nameEn               String?
  code                 String
  order                Int                    @default(0)
  floorId              String
  buildingId           String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  inventoryItems       InventoryItem[]
  tickets              Ticket[]
  workOrders           WorkOrder[]
  assets               Asset[]
  oldLocationHistories AssetLocationHistory[] @relation("oldRoom")
  newLocationHistories AssetLocationHistory[] @relation("newRoom")
  building             Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor                Floor                  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([floorId, code])
  @@map("rooms")
}

// ============================================================
// 2. نماذج القوائم الموحدة (Lookups) – بعد التعديل
// ============================================================

// ----------------------------------------------
// WorkOrderType (بدلاً من WorkOrderTypeLookup)
// ----------------------------------------------
model WorkOrderType {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  icon        String?   @db.VarChar(50)
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_types")
}

// ----------------------------------------------
// WorkOrderStatus
// ----------------------------------------------
model WorkOrderStatus {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  icon        String?   @db.VarChar(50)
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_statuses")
}

// ----------------------------------------------
// WorkOrderPriority
// ----------------------------------------------
model WorkOrderPriority {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  icon        String?   @db.VarChar(50)
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_priorities")
}

// ----------------------------------------------
// AssetType
// ----------------------------------------------
model AssetType {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  icon        String?   @db.VarChar(50)
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets               Asset[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders           WorkOrder[] // 👈 الحقل المفقود

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("asset_types")
}

// ----------------------------------------------
// AssetStatus
// ----------------------------------------------
model AssetStatus {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  icon        String?   @db.VarChar(50)
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("asset_statuses")
}

// ============================================================
// WorkOrderCloseReason
// ============================================================
model WorkOrderCloseReason {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_close_reasons")
}

// ============================================================
// WorkOrderCancelReason
// ============================================================
model WorkOrderCancelReason {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?   @db.Text
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_cancel_reasons")
}

// ============================================================
// 3. باقي النماذج (Asset, WorkOrder, Ticket, ...)
// ============================================================

model Asset {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  nameEn              String?
  description         String?
  typeId              String?
  statusId            String?
  roomId              String
  purchaseDate        DateTime?
  operationDate       DateTime?
  warrantyEnd         DateTime?
  notes               String?
  qrCode              String?   @unique
  companyId           String
  buildingId          String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  branchId            String?   @map("branch_id")
  lastMaintenanceDate DateTime?
  serialNumber        String?
  manufacturer        String?
  model               String?
  supplierId          String?

  scheduleAssets    ScheduleAsset[]
  tickets           Ticket[]
  workOrderAssets   WorkOrderAsset[]
  locationHistories AssetLocationHistory[]
  branch            Branch?                @relation(fields: [branchId], references: [id])
  building          Building               @relation(fields: [buildingId], references: [id])
  company           Company                @relation(fields: [companyId], references: [id])
  room              Room                   @relation(fields: [roomId], references: [id])
  status            AssetStatus?           @relation(fields: [statusId], references: [id])
  type              AssetType?             @relation(fields: [typeId], references: [id])
  supplier          Supplier?              @relation(fields: [supplierId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([typeId])
  @@index([statusId])
  @@index([roomId])
  @@index([buildingId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("assets")
  @@index([supplierId])  // ✅ فهرس جديد لتحسين الأداء
}

model AssetLocationHistory {
  id            String   @id @default(cuid())
  assetId       String   @map("asset_id")
  oldRoomId     String?  @map("old_room_id")
  newRoomId     String   @map("new_room_id")
  oldBuildingId String?  @map("old_building_id")
  newBuildingId String   @map("new_building_id")
  oldBranchId   String?  @map("old_branch_id")
  newBranchId   String   @map("new_branch_id")
  changedBy     String   @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at")
  reason        String?

  asset   Asset @relation(fields: [assetId], references: [id])
  oldRoom Room? @relation("oldRoom", fields: [oldRoomId], references: [id])
  newRoom Room  @relation("newRoom", fields: [newRoomId], references: [id])

  @@index([assetId])
  @@index([changedAt])
  @@map("asset_location_history")
}

model AssetCounter {
  typeId    String
  branchId  String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([typeId, branchId])
}

model WorkOrderCounter {
  branchId  String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())

  entityType String
  entityId   String

  companyId  String
  branchId   String?

  userId     String
  userEmail  String

  action     String

  field       String?
  oldValue    String?
  newValue    String?

  changes    Json?
  metadata   Json?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model InventoryItem {
  id                 String               @id @default(cuid())
  sku                String?              @unique
  name               String
  nameEn             String?
  quantity           Int                  @default(0)
  minQuantity        Int                  @default(0)
  unit               String?              @default("قطعة")
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  roomId             String
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id])
  room               Room                 @relation(fields: [roomId], references: [id])
  workOrderInventory WorkOrderInventory[]

  @@index([companyId])
  @@index([roomId])
  @@index([sku])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("inventory_items")
}

model WorkOrderInventory {
  id              String        @id @default(cuid())
  workOrderId     String
  inventoryItemId String
  quantity        Int
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, inventoryItemId])
  @@map("work_order_inventory")
}

model ContractAttachment {
  id           String    @id @default(cuid())
  contractId   String?
  url          String
  key          String
  fileName     String?
  originalName String
  provider     String    @default("CLOUDFLARE_R2")
  mimeType     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Contract {
  id                 String               @id @default(cuid())
  code               String?              @unique
  title              String
  supplier           String
  value              Float
  startDate          DateTime
  endDate            DateTime
  description        String?
  status             ContractStatus       @default(PENDING_REVIEW)
  cancellationReason String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  companyId          String
  branchId           String?
  createdBy          String?
  agentName          String?
  agentPhone         String?
  agentEmail         String?
  branch             Branch?              @relation(fields: [branchId], references: [id])
  company            Company              @relation(fields: [companyId], references: [id])
  attachments        ContractAttachment[]

  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("contracts")
}

model WorkOrder {
  id              String            @id @default(cuid())
  code            String?           @unique
  branchSeqNum    Int
  title           String
  description     String?
  type            WorkOrderTypeEnum @default(MAINTENANCE)
  priorityId      String?
  statusId        String?
  roomId          String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  companyId       String
  branchId        String?
  createdBy       String?
  assetTypeId     String?
  workOrderTypeId String?
  ticketId        String?           @unique
  sourceId        String? // معرف المصدر (ticketId, pmPlanId, checklistId)
  sourceType      String? // 'ticket', 'pm', 'checklist', 'manual'
  reason          String?   // سبب الإنشاء

  assetType     AssetType?         @relation(fields: [assetTypeId], references: [id])
  branch        Branch?            @relation(fields: [branchId], references: [id])
  company       Company            @relation(fields: [companyId], references: [id])
  priority      WorkOrderPriority? @relation(fields: [priorityId], references: [id])
  room          Room?              @relation(fields: [roomId], references: [id])
  status        WorkOrderStatus?   @relation(fields: [statusId], references: [id])
  workOrderType WorkOrderType?     @relation(fields: [workOrderTypeId], references: [id])
  ticket        Ticket?            @relation(fields: [ticketId], references: [id])
  assignedTo    String?
  createdByUser User?             @relation("CreatedWorkOrders", fields: [createdBy], references: [id])
  assignedUser  User?             @relation("AssignedWorkOrders", fields: [assignedTo], references: [id])

  workOrderAssets    WorkOrderAsset[]
  attachments        WorkOrderAttachment[]
  workOrderInventory WorkOrderInventory[]

  @@unique([branchId, branchSeqNum])
  @@index([companyId, deletedAt])
  @@index([companyId])
  @@index([branchId])
  @@index([roomId])
  @@index([statusId])
  @@index([priorityId])
  @@index([workOrderTypeId])
  @@index([createdAt])
  @@map("work_orders")
}

model WorkOrderAsset {
  workOrderId String
  assetId     String
  completedAt DateTime?
  notes       String?
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, assetId])
}

model WorkOrderAttachment {
  id           String    @id @default(cuid())
  workOrderId  String
  url          String
  key          String
  fileName     String
  originalName String
  provider     String    @default("CLOUDFLARE_R2")
  mimeType     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model MaintenanceSchedule {
  id             String          @id @default(cuid())
  name           String
  frequency      String
  leadDays       Int             @default(30)
  branchId       String?
  buildingId     String?
  assetTypeId    String?
  companyId      String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastRunAt      DateTime?
  notes          String?
  startDate      DateTime?
  frequencyDays  Int?
  assetType      AssetType?      @relation(fields: [assetTypeId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  building       Building?       @relation(fields: [buildingId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id])
  scheduleAssets ScheduleAsset[]
}

model ScheduleAsset {
  scheduleId String
  assetId    String
  asset      Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schedule   MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, assetId])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  url          String
  key          String
  provider     String   @default("CLOUDFLARE_R2")
  mimeType     String
  size         Int
  originalName String
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Ticket {
  id              String             @id @default(cuid())
  code            String             @unique
  branchSeqNum    Int
  title           String
  description     String?
  assetId         String?
  roomId          String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  companyId       String
  branchId        String
  createdBy       String?
  type            TicketType         @default(MAINTENANCE)
  phone           String?
  reporterEmail   String
  reporterName    String
  status          TicketStatus       @default(PENDING)
  rejectionReason String?
  asset           Asset?             @relation(fields: [assetId], references: [id])
  branch          Branch             @relation(fields: [branchId], references: [id])
  company         Company            @relation(fields: [companyId], references: [id])
  room            Room?              @relation(fields: [roomId], references: [id])
  attachments     TicketAttachment[]
  workOrder       WorkOrder?
  userId          String?  // ✅ أضف هذا إذا لم يكن موجوداً
  user            User?              @relation("UserTickets", fields: [userId], references: [id])

  @@unique([branchId, branchSeqNum])
  @@index([companyId])
  @@index([branchId])
  @@index([assetId])
  @@index([roomId])
  @@index([status])
  @@index([branchSeqNum])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("tickets")
}

model Vehicle {
  id          String   @id @default(cuid())
  name        String
  plateNumber String?
  buildingId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  building          Building           @relation(fields: [buildingId], references: [id])
  accidentRequests  AccidentRequest[]
  oilChangeRequests OilChangeRequest[]

  @@map("vehicles")
}

model AccidentRequest {
  id          String   @id @default(cuid())
  vehicleId   String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("accident_requests")
}

model OilChangeRequest {
  id          String   @id @default(cuid())
  vehicleId   String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("oil_change_requests")
}

model SavedReport {
  id          String   @id @default(cuid())
  name        String
  description String?
  modelType   String
  columns     String
  filters     String?
  sortBy      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  companyId   String

  @@index([userId])
  @@index([companyId])
  @@index([userId, companyId, updatedAt(sort: Desc)])
  @@map("saved_reports")
}

// نموذج المورد (Supplier) - موجود مسبقاً
// ============================================================
model Supplier {
  id            String    @id @default(cuid())
  name          String
  nameEn        String?
  code          String?   @unique
  description   String?
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  address       String?
  taxNumber     String?
  isActive      Boolean   @default(true)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // ✅ علاقة عكسية مع الأصول (جديدة)
  assets        Asset[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@index([deletedAt])
}

