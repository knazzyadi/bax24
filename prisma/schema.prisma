generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  nameEn                 String?
  address                String?
  phone                  String?
  email                  String?
  subscriptionStartDate  DateTime?
  subscriptionEndDate    DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  assetStatuses          AssetStatus[]
  assetTypes             AssetType[]
  assets                 Asset[]
  branches               Branch[]
  buildings              Building[]
  companyBackups         CompanyBackup[]
  contracts              Contract[]
  inspectionCategories   InspectionCategory[]
  inspectionItems        InspectionItem[]
  inspectionSections     InspectionSection[]
  inspectionTemplates    InspectionTemplate[]
  inspections            Inspection[]
  inventoryItems         InventoryItem[]
  maintenanceSchedules   MaintenanceSchedule[]
  suppliers              Supplier[]
  tickets                Ticket[]
  users                  User[]
  workOrderCancelReasons WorkOrderCancelReason[]
  workOrderCloseReasons  WorkOrderCloseReason[]
  workOrderPriorities    WorkOrderPriority[]
  workOrderStatuses      WorkOrderStatus[]
  workOrderTypes         WorkOrderType[]
  workOrders             WorkOrder[]

  @@map("companies")
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  name                      String?
  password                  String?
  status                    Boolean                  @default(true)
  companyId                 String?
  roleId                    String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  invitationToken           String?                  @unique
  invitationExpires         DateTime?
  resetToken                String?                  @unique
  resetExpires              DateTime?
  firstLogin                Boolean                  @default(true)
  deletedAt                 DateTime?
  maintenanceScheduleRuns   MaintenanceScheduleRun[]
  createdBackups            CompanyBackup[]          @relation("UserCreatedBackups")
  inspectionActivities      InspectionActivity[]
  inspectionResultsExecuted InspectionResult[]       @relation("InspectionExecutedBy")
  inspectionsApproved       Inspection[]             @relation("InspectionApprover")
  inspectionsToPerform      Inspection[]             @relation("InspectionInspector")
  tickets                   Ticket[]                 @relation("UserTickets")
  userBranches              UserBranch[]
  company                   Company?                 @relation(fields: [companyId], references: [id])
  role                      Role?                    @relation(fields: [roleId], references: [id])
  assignedWorkOrders        WorkOrder[]              @relation("AssignedWorkOrders")
  createdWorkOrders         WorkOrder[]              @relation("CreatedWorkOrders")
  InspectionFinding         InspectionFinding[]

  @@map("users")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("roles")
}

model UserBranch {
  userId     String
  branchId   String
  assignedAt DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Branch {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  nameEn               String?
  allowPublicTickets   Boolean               @default(true)
  publicToken          String                @unique @default(cuid())
  slug                 String                @unique
  deletedAt            DateTime?
  assets               Asset[]
  company              Company               @relation(fields: [companyId], references: [id])
  buildings            Building[]
  contracts            Contract[]
  inspections          Inspection[]
  maintenanceSchedules MaintenanceSchedule[]
  tickets              Ticket[]
  userBranches         UserBranch[]
  workOrders           WorkOrder[]

  @@map("branches")
}

model Building {
  id                   String                @id @default(cuid())
  name                 String
  nameEn               String?
  code                 String                @unique
  order                Int                   @default(0)
  branchId             String?
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  assets               Asset[]
  branch               Branch?               @relation(fields: [branchId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id])
  floors               Floor[]
  inspections          Inspection[]
  maintenanceSchedules MaintenanceSchedule[]
  rooms                Room[]
  vehicles             Vehicle[]
  WorkOrder            WorkOrder[]

  @@index([companyId, deletedAt])
  @@index([branchId])
  @@index([createdAt])
  @@map("buildings")
}

model Floor {
  id                   String                @id @default(cuid())
  name                 String
  nameEn               String?
  code                 String
  buildingId           String
  order                Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  building             Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  inspections          Inspection[]
  maintenanceSchedules MaintenanceSchedule[]
  rooms                Room[]
  WorkOrder            WorkOrder[]

  @@unique([buildingId, code])
  @@map("floors")
}

model Room {
  id                   String                 @id @default(cuid())
  name                 String
  nameEn               String?
  code                 String
  order                Int                    @default(0)
  floorId              String
  buildingId           String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  newLocationHistories AssetLocationHistory[] @relation("newRoom")
  oldLocationHistories AssetLocationHistory[] @relation("oldRoom")
  assets               Asset[]
  inspections          Inspection[]
  inventoryItems       InventoryItem[]
  maintenanceSchedules MaintenanceSchedule[]
  building             Building               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor                Floor                  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tickets              Ticket[]
  workOrders           WorkOrder[]

  @@unique([floorId, code])
  @@map("rooms")
}

model WorkOrderType {
  id          String      @id @default(cuid())
  code        String?     @db.VarChar(20)
  name        String      @db.VarChar(100)
  nameEn      String?     @db.VarChar(100)
  description String?
  color       String?     @db.VarChar(20)
  icon        String?     @db.VarChar(50)
  order       Int         @default(0)
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders  WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_types")
}

model WorkOrderStatus {
  id          String      @id @default(cuid())
  code        String?     @db.VarChar(20)
  name        String      @db.VarChar(100)
  nameEn      String?     @db.VarChar(100)
  description String?
  color       String?     @db.VarChar(20)
  icon        String?     @db.VarChar(50)
  order       Int         @default(0)
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders  WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_statuses")
}

model WorkOrderPriority {
  id          String      @id @default(cuid())
  code        String?     @db.VarChar(20)
  name        String      @db.VarChar(100)
  nameEn      String?     @db.VarChar(100)
  description String?
  color       String?     @db.VarChar(20)
  icon        String?     @db.VarChar(50)
  order       Int         @default(0)
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders  WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_priorities")
}

model AssetType {
  id                   String                @id @default(cuid())
  name                 String                @db.VarChar(100)
  nameEn               String?               @db.VarChar(100)
  code                 String?               @db.VarChar(20)
  description          String?
  order                Int                   @default(0)
  isDefault            Boolean               @default(false)
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  color                String?               @db.VarChar(20)
  deletedAt            DateTime?
  icon                 String?               @db.VarChar(50)
  isActive             Boolean               @default(true)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets               Asset[]
  maintenanceSchedules MaintenanceSchedule[]
  workOrders           WorkOrder[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("asset_types")
}

model AssetStatus {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  code        String?   @db.VarChar(20)
  description String?
  color       String?   @db.VarChar(20)
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  icon        String?   @db.VarChar(50)
  isActive    Boolean   @default(true)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets      Asset[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("asset_statuses")
}

model WorkOrderCloseReason {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_close_reasons")
}

model WorkOrderCancelReason {
  id          String    @id @default(cuid())
  code        String?   @db.VarChar(20)
  name        String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  description String?
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([order])
  @@index([isActive])
  @@index([deletedAt])
  @@map("work_order_cancel_reasons")
}

model Asset {
  id                  String                 @id @default(cuid())
  code                String
  name                String
  nameEn              String?
  typeId              String?
  statusId            String?
  roomId              String
  purchaseDate        DateTime?
  warrantyEnd         DateTime?
  notes               String?
  qrCode              String?                @unique
  companyId           String
  buildingId          String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  branchId            String?                @map("branch_id")
  lastMaintenanceDate DateTime?
  description         String?
  manufacturer        String?
  model               String?
  operationDate       DateTime?
  serialNumber        String?
  supplierId          String?
  scheduleAssets      ScheduleAsset[]
  workOrderAssets     WorkOrderAsset[]
  locationHistories   AssetLocationHistory[]
  branch              Branch?                @relation(fields: [branchId], references: [id])
  building            Building               @relation(fields: [buildingId], references: [id])
  company             Company                @relation(fields: [companyId], references: [id])
  room                Room                   @relation(fields: [roomId], references: [id])
  status              AssetStatus?           @relation(fields: [statusId], references: [id])
  supplier            Supplier?              @relation(fields: [supplierId], references: [id])
  type                AssetType?             @relation(fields: [typeId], references: [id])
  tickets             Ticket[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([typeId])
  @@index([statusId])
  @@index([roomId])
  @@index([buildingId])
  @@index([deletedAt])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@index([supplierId])
  @@map("assets")
}

model AssetLocationHistory {
  id            String   @id @default(cuid())
  assetId       String   @map("asset_id")
  oldRoomId     String?  @map("old_room_id")
  newRoomId     String   @map("new_room_id")
  oldBuildingId String?  @map("old_building_id")
  newBuildingId String   @map("new_building_id")
  oldBranchId   String?  @map("old_branch_id")
  newBranchId   String   @map("new_branch_id")
  changedBy     String   @map("changed_by")
  changedAt     DateTime @default(now()) @map("changed_at")
  reason        String?
  asset         Asset    @relation(fields: [assetId], references: [id])
  newRoom       Room     @relation("newRoom", fields: [newRoomId], references: [id])
  oldRoom       Room?    @relation("oldRoom", fields: [oldRoomId], references: [id])

  @@index([assetId])
  @@index([changedAt])
  @@map("asset_location_history")
}

model AssetCounter {
  typeId    String
  branchId  String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([typeId, branchId])
}

model WorkOrderCounter {
  branchId  String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  companyId  String
  branchId   String?
  userId     String
  userEmail  String
  action     String
  field      String?
  oldValue   String?
  newValue   String?
  changes    Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
}

model InventoryItem {
  id                 String               @id @default(cuid())
  sku                String?              @unique
  name               String
  nameEn             String?
  quantity           Int                  @default(0)
  minQuantity        Int                  @default(0)
  unit               String?              @default("قطعة")
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  roomId             String
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id])
  room               Room                 @relation(fields: [roomId], references: [id])
  workOrderInventory WorkOrderInventory[]

  @@index([companyId])
  @@index([roomId])
  @@index([sku])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("inventory_items")
}

model WorkOrderInventory {
  id              String        @id @default(cuid())
  workOrderId     String
  inventoryItemId String
  quantity        Int
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, inventoryItemId])
  @@map("work_order_inventory")
}

model ContractAttachment {
  id           String    @id @default(cuid())
  contractId   String?
  url          String
  key          String
  fileName     String?
  originalName String
  provider     String    @default("CLOUDFLARE_R2")
  mimeType     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Contract {
  id                 String               @id @default(cuid())
  code               String?              @unique
  title              String
  supplier           String
  value              Float
  startDate          DateTime
  endDate            DateTime
  description        String?
  status             ContractStatus       @default(PENDING_REVIEW)
  cancellationReason String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  companyId          String
  branchId           String?
  createdBy          String?
  agentName          String?
  agentPhone         String?
  agentEmail         String?
  attachments        ContractAttachment[]
  branch             Branch?              @relation(fields: [branchId], references: [id])
  company            Company              @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("contracts")
}

model WorkOrder {
  id                    String                  @id @default(cuid())
  code                  String?                 @unique
  branchSeqNum          Int
  title                 String
  description           String?
  type                  WorkOrderTypeEnum       @default(MAINTENANCE)
  priorityId            String?
  statusId              String?
  roomId                String?
  notes                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  companyId             String
  branchId              String?
  createdBy             String?
  assetTypeId           String?
  workOrderTypeId       String?
  ticketId              String?                 @unique
  assignedTo            String?
  reason                String?
  sourceId              String?
  sourceType            String?
  maintenanceScheduleId String?
  buildingId            String?
  floorId               String?
  locationLevel         LocationLevel?
  source                WorkOrderSource         @default(manual)
  scheduleRuns          MaintenanceScheduleRun?
  workOrderAssets       WorkOrderAsset[]
  attachments           WorkOrderAttachment[]
  inspection_results    InspectionResult[]
  workOrderInventory    WorkOrderInventory[]
  assetType             AssetType?              @relation(fields: [assetTypeId], references: [id])
  assignedUser          User?                   @relation("AssignedWorkOrders", fields: [assignedTo], references: [id])
  branch                Branch?                 @relation(fields: [branchId], references: [id])
  building              Building?               @relation(fields: [buildingId], references: [id])
  company               Company                 @relation(fields: [companyId], references: [id])
  createdByUser         User?                   @relation("CreatedWorkOrders", fields: [createdBy], references: [id])
  floor                 Floor?                  @relation(fields: [floorId], references: [id])
  maintenanceSchedule   MaintenanceSchedule?    @relation(fields: [maintenanceScheduleId], references: [id])
  priority              WorkOrderPriority?      @relation(fields: [priorityId], references: [id])
  room                  Room?                   @relation(fields: [roomId], references: [id])
  status                WorkOrderStatus?        @relation(fields: [statusId], references: [id])
  ticket                Ticket?                 @relation(fields: [ticketId], references: [id])
  workOrderType         WorkOrderType?          @relation(fields: [workOrderTypeId], references: [id])
  WorkOrderFinding      WorkOrderFinding[]

  @@unique([branchId, branchSeqNum])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@index([branchId])
  @@index([buildingId])
  @@index([floorId])
  @@index([roomId])
  @@index([statusId])
  @@index([priorityId])
  @@index([assetTypeId])
  @@index([workOrderTypeId])
  @@index([maintenanceScheduleId])
  @@index([createdAt])
  @@map("work_orders")
}

model WorkOrderAsset {
  workOrderId String
  assetId     String
  completedAt DateTime?
  notes       String?
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@id([workOrderId, assetId])
}

model WorkOrderAttachment {
  id           String    @id @default(cuid())
  workOrderId  String
  url          String
  key          String
  fileName     String
  originalName String
  provider     String    @default("CLOUDFLARE_R2")
  mimeType     String
  size         Int
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model MaintenanceSchedule {
  id             String                   @id @default(cuid())
  name           String
  frequency      String
  frequencyDays  Int?                     @default(30)
  leadDays       Int                      @default(30)
  startDate      DateTime?
  lastRunAt      DateTime?
  notes          String?
  isActive       Boolean                  @default(true)
  companyId      String
  branchId       String?
  buildingId     String?
  floorId        String?
  roomId         String?
  locationLevel  String?
  assetTypeId    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  runs           MaintenanceScheduleRun[]
  scheduleAssets ScheduleAsset[]
  assetType      AssetType?               @relation(fields: [assetTypeId], references: [id])
  branch         Branch?                  @relation(fields: [branchId], references: [id])
  building       Building?                @relation(fields: [buildingId], references: [id])
  company        Company                  @relation(fields: [companyId], references: [id])
  floor          Floor?                   @relation(fields: [floorId], references: [id])
  room           Room?                    @relation(fields: [roomId], references: [id])
  workOrders     WorkOrder[]

  @@index([companyId])
  @@index([branchId])
  @@index([buildingId])
  @@index([floorId])
  @@index([roomId])
  @@map("maintenance_schedules")
}

model MaintenanceScheduleRun {
  id              String              @id @default(cuid())
  /// الجدول الذي تم تشغيله
  scheduleId      String
  /// أمر العمل الناتج (قد يكون null عند الفشل)
  workOrderId     String?             @unique
  /// حالة التنفيذ
  status          ScheduleRunStatus   @default(RUNNING)
  /// يدوي أو تلقائي
  runType         ScheduleRunType     @default(MANUAL)
  /// وقت البداية والنهاية
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  /// إحصائيات التنفيذ
  totalAssets     Int                 @default(0)
  succeededAssets Int                 @default(0)
  failedAssets    Int                 @default(0)
  /// من قام بالتشغيل
  executedById    String?
  /// ملاحظات التنفيذ
  notes           String?
  /// رسالة الخطأ عند الفشل
  errorMessage    String?
  createdAt       DateTime            @default(now())
  user            User?               @relation(fields: [executedById], references: [id])
  schedule        MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?          @relation(fields: [workOrderId], references: [id])

  @@index([scheduleId, startedAt])
  @@index([status])
  @@index([workOrderId])
}

model ScheduleAsset {
  scheduleId String
  assetId    String
  asset      Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schedule   MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, assetId])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  url          String
  key          String
  provider     String   @default("CLOUDFLARE_R2")
  mimeType     String
  size         Int
  originalName String
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Ticket {
  id              String             @id @default(cuid())
  code            String             @unique
  branchSeqNum    Int
  title           String
  description     String?
  assetId         String?
  roomId          String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  companyId       String
  branchId        String
  createdBy       String?
  type            TicketType         @default(MAINTENANCE)
  phone           String?
  reporterEmail   String
  reporterName    String
  status          TicketStatus       @default(PENDING)
  rejectionReason String?
  userId          String?
  attachments     TicketAttachment[]
  asset           Asset?             @relation(fields: [assetId], references: [id])
  branch          Branch             @relation(fields: [branchId], references: [id])
  company         Company            @relation(fields: [companyId], references: [id])
  room            Room?              @relation(fields: [roomId], references: [id])
  user            User?              @relation("UserTickets", fields: [userId], references: [id])
  workOrder       WorkOrder?

  @@unique([branchId, branchSeqNum])
  @@index([companyId])
  @@index([branchId])
  @@index([assetId])
  @@index([roomId])
  @@index([status])
  @@index([branchSeqNum])
  @@index([companyId, deletedAt])
  @@index([createdAt])
  @@map("tickets")
}

model Vehicle {
  id                String             @id @default(cuid())
  name              String
  plateNumber       String?
  buildingId        String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accidentRequests  AccidentRequest[]
  oilChangeRequests OilChangeRequest[]
  building          Building           @relation(fields: [buildingId], references: [id])

  @@map("vehicles")
}

model AccidentRequest {
  id          String   @id @default(cuid())
  vehicleId   String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@map("accident_requests")
}

model OilChangeRequest {
  id          String   @id @default(cuid())
  vehicleId   String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@map("oil_change_requests")
}

model SavedReport {
  id          String   @id @default(cuid())
  name        String
  description String?
  modelType   String
  columns     String
  filters     String?
  sortBy      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  companyId   String

  @@index([userId])
  @@index([companyId])
  @@index([userId, companyId, updatedAt(sort: Desc)])
  @@map("saved_reports")
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  nameEn        String?
  code          String?   @unique
  description   String?
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  address       String?
  taxNumber     String?
  isActive      Boolean   @default(true)
  order         Int       @default(0)
  companyId     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  assets        Asset[]
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("suppliers")
}

model Inspection {
  code               String?
  id                 String                        @id @default(cuid())
  companyId          String
  title              String                        @db.VarChar(255)
  notes              String?
  branchId           String?
  buildingId         String?
  floorId            String?
  roomId             String?
  scheduledDate      DateTime
  startedAt          DateTime?
  completedAt        DateTime?
  approvedAt         DateTime?
  inspectorId        String?
  approvedById       String?
  status             InspectionStatus              @default(draft)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  deletedAt          DateTime?
  activities         InspectionActivity[]
  selectedCategories InspectionCategorySelection[]
  formItems          InspectionFormItem[]
  results            InspectionResult[]
  approvedBy         User?                         @relation("InspectionApprover", fields: [approvedById], references: [id])
  branch             Branch?                       @relation(fields: [branchId], references: [id])
  building           Building?                     @relation(fields: [buildingId], references: [id])
  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  floor              Floor?                        @relation(fields: [floorId], references: [id])
  inspector          User?                         @relation("InspectionInspector", fields: [inspectorId], references: [id])
  room               Room?                         @relation(fields: [roomId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([scheduledDate])
  @@index([branchId])
  @@index([buildingId])
  @@index([floorId])
  @@index([roomId])
  @@map("inspections")
}

model InspectionCategorySelection {
  id           String             @id @default(cuid())
  inspectionId String
  categoryId   String
  sortOrder    Int                @default(0)
  category     InspectionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inspection   Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, categoryId])
  @@index([inspectionId])
  @@index([categoryId])
  @@map("inspection_category_selections")
}

model InspectionResult {
  id                   String                  @id @default(cuid())
  inspectionId         String
  result               ResultStatus            @default(na)
  notes                String?
  score                Decimal?                @db.Decimal(10, 2)
  maxScore             Decimal?                @db.Decimal(10, 2)
  minScore             Decimal?
  executedAt           DateTime?               @default(now())
  updatedAt            DateTime                @updatedAt
  executedById         String?
  workOrderId          String?
  inspectionFormItemId String
  images               InspectionResultImage[]
  executedBy           User?                   @relation("InspectionExecutedBy", fields: [executedById], references: [id])
  inspectionFormItem   InspectionFormItem      @relation(fields: [inspectionFormItemId], references: [id], onDelete: Cascade)
  inspection           Inspection              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  work_orders          WorkOrder?              @relation(fields: [workOrderId], references: [id])
  findings             InspectionFinding[]

  @@unique([inspectionId, inspectionFormItemId])
  @@index([inspectionId])
  @@index([inspectionFormItemId])
  @@index([result])
  @@map("inspection_results")
}

model InspectionResultImage {
  id        String           @id @default(cuid())
  resultId  String
  url       String
  caption   String?
  createdAt DateTime         @default(now())
  fileName  String?
  mimeType  String?
  size      Int?
  comment   String?
  result    InspectionResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("inspection_result_images")
}

model InspectionActivity {
  id           String     @id @default(cuid())
  inspectionId String
  userId       String
  action       String
  details      Json?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@index([inspectionId])
  @@index([userId])
  @@map("inspection_activities")
}

model CompanyBackup {
  id           String       @id @default(cuid())
  companyId    String
  fileName     String
  fileUrl      String?
  fileSize     Int?
  status       BackupStatus @default(COMPLETED)
  createdById  String
  createdAt    DateTime     @default(now())
  restoredAt   DateTime?
  restoredById String?
  type         BackupType   @default(FULL)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("UserCreatedBackups", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([createdAt])
  @@map("company_backups")
}

model InspectionSection {
  id          String               @id @default(cuid())
  companyId   String
  code        String               @db.VarChar(50)
  name        String               @db.VarChar(255)
  nameAr      String?              @db.VarChar(255)
  description String?
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templates   InspectionTemplate[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@map("inspection_sections")
}

model InspectionTemplate {
  id          String               @id @default(cuid())
  companyId   String
  sectionId   String
  code        String               @db.VarChar(50)
  name        String               @db.VarChar(255)
  nameAr      String?              @db.VarChar(255)
  description String?
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  categories  InspectionCategory[]
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section     InspectionSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([sectionId])
  @@index([isActive])
  @@map("inspection_templates")
}

model InspectionCategory {
  id          String                        @id @default(cuid())
  companyId   String
  code        String                        @db.VarChar(50)
  name        String                        @db.VarChar(255)
  nameAr      String?                       @db.VarChar(255)
  description String?
  isActive    Boolean                       @default(true)
  sortOrder   Int                           @default(0)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  deletedAt   DateTime?
  templateId  String
  company     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template    InspectionTemplate            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  selections  InspectionCategorySelection[]
  items       InspectionItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([templateId])
  @@index([isActive])
  @@map("inspection_categories")
}

model InspectionItem {
  id                  String             @id @default(cuid())
  companyId           String
  categoryId          String
  code                String             @db.VarChar(50)
  name                String             @db.VarChar(255)
  nameAr              String?            @db.VarChar(255)
  description         String?
  cbahiCode           String?            @db.VarChar(100)
  riskLevel           RiskLevel          @default(medium)
  inputType           InputType          @default(pass_fail)
  autoCreateWorkOrder Boolean            @default(false)
  sortOrder           Int                @default(0)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  category            InspectionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@map("inspection_items")
}

model InspectionFormItem {
  id                  String             @id @default(cuid())
  inspectionId        String
  categoryId          String
  itemId              String?
  categoryName        String
  categoryNameAr      String?
  itemCode            String?
  itemName            String
  itemNameAr          String?
  description         String?
  descriptionAr       String?
  riskLevel           String?
  inputType           String?
  sortOrder           Int
  autoCreateWorkOrder Boolean            @default(false)
  isRequired          Boolean            @default(true)
  inspection          Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  results             InspectionResult[]

  @@unique([inspectionId, itemId])
  @@index([inspectionId])
  @@index([categoryId])
  @@map("inspection_form_items")
}

model InspectionFinding {
  id                 String        @id @default(cuid())
  inspectionResultId String
  title              String
  description        String?
  riskLevel          RiskLevel
  correctiveAction   String?
  dueDate            DateTime?
  status             FindingStatus @default(Open)
  createdById        String?

  inspectionResult InspectionResult @relation(fields: [inspectionResultId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation(fields: [createdById], references: [id])

  images     InspectionFindingImage[]
  workOrders WorkOrderFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkOrderFinding {
  id          String    @id @default(cuid())
  workOrderId String
  findingId   String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  finding InspectionFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, findingId])
}

model InspectionFindingImage {
  id        String   @id @default(cuid())
  findingId String
  url       String
  fileName  String?
  createdAt DateTime @default(now())

  finding InspectionFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

enum FindingStatus {
  Open
  InProgress
  Resolved
  Verified
  Closed
  Cancelled
}

enum LocationLevel {
  building
  floor
  room
}

enum InspectionStatus {
  draft
  in_progress
  completed
  approved
  cancelled
}

enum ResultStatus {
  pass
  fail
  na
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum InputType {
  pass_fail
  numeric
  text
}

enum TicketType {
  MAINTENANCE
  INCIDENT
}

enum TicketStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractStatus {
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  CANCELLED
}

enum WorkOrderTypeEnum {
  MAINTENANCE
  CORRECTIVE
  EMERGENCY
  BULK_PREVENTIVE
}

enum BackupStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BackupType {
  FULL
  CONFIG
  CUSTOM
}

enum ScheduleRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
}

enum ScheduleRunType {
  MANUAL
  AUTOMATIC
}

enum WorkOrderSource {
  manual
  ticket
  ppm
  checklist
  inspection_finding
}